# SmartMatch Environment Configuration

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production-smartmatch-super-secret-key-32chars
JWT_SECRET_KEY=change-me-in-production-jwt-smartmatch-secret-key-32chars
JWT_ACCESS_TOKEN_EXPIRES=86400

# Server Port
PORT=5000

# MongoDB Configuration
# Leave empty or set to 'mock' to use high-performance in-memory mongomock for testing/offline dev
# For production/Atlas, provide: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartmatch?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=smartmatch

# Gemini Multimodal AI Settings
# Get an API key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# CORS Allowed Origins (comma-separated or * for development)
CORS_ORIGINS=*
