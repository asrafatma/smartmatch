# SmartMatch environment configuration. Copy to .env and fill in. NEVER commit .env.

# --- Flask ---
FLASK_ENV=development            # use "production" when deployed
FLASK_DEBUG=1                    # 0 in production
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=86400   # seconds (24h)
PORT=5000

# --- MongoDB Atlas ---
# Empty or "mock" = in-memory database (data lost on restart; for tests/offline only)
# Atlas: Clusters -> Connect -> Drivers -> Python, then insert your database user's password
MONGODB_URI=
MONGODB_DB_NAME=smartmatch
# Fall back to in-memory DB if Atlas is unreachable? (defaults: 1 in development, 0 in production)
MONGODB_ALLOW_MOCK_FALLBACK=1

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

# --- Uploads ---
UPLOAD_FOLDER=uploads            # relative paths resolve from the project root
MAX_IMAGE_BYTES=5242880          # 5 MB per photo (413 above this)
MAX_CONTENT_LENGTH=6291456       # whole request cap
IMAGE_STORAGE_GRIDFS=1           # mirror images into MongoDB GridFS (needed on ephemeral hosts)

# --- Security ---
# Optional: staff can self-register as admin with this code. Leave empty to disable.
ADMIN_INVITE_CODE=
# Frontend is served by Flask (same origin). Only set for a separate frontend host.
CORS_ORIGINS=
RATE_LIMIT_ENABLED=1
MAX_CLAIM_ATTEMPTS=3
CLAIM_VERIFICATION_THRESHOLD=0.6
MIN_INCIDENT_DATE=2020-01-01

# --- Deployment ---
AUTO_SEED_DEMO_DATA=1            # seed demo accounts when the database is empty
